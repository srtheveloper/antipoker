# ─── Docker Hub ────────────────────────────────────────────────────────────────
# Il tuo username su Docker Hub (usato per il tag delle immagini)
DOCKER_USERNAME=yourusername

# ─── Frontend → Backend URL ────────────────────────────────────────────────────
# Questa URL viene INCLUSA nella build statica del frontend (Vite).
# Deve essere raggiungibile dal browser dell'utente finale, NON dal container.
# In locale:
VITE_BACKEND_URL=http://localhost:3001
# In produzione (esempio con dominio reale):
# VITE_BACKEND_URL=https://api.antipoker.example.com
